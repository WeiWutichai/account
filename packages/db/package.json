{
  "name": "@innovera/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./seed": "./src/seed.ts",
    "./migrate": "./src/migrate.ts",
    "./import": "./src/import.ts",
    "./ledger": "./src/ledger-service.ts",
    "./queries": "./src/queries.ts",
    "./sales": "./src/sales.ts"
  },
  "scripts": {
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx src/migrate-cli.ts up",
    "migrate:down": "tsx src/migrate-cli.ts down",
    "seed:dev": "tsx src/dev-seed.ts",
    "reset:dev": "tsx src/migrate-cli.ts reset"
  },
  "dependencies": {
    "@innovera/ledger": "workspace:*",
    "@innovera/tax-th": "workspace:*",
    "decimal.js": "10.6.0",
    "exceljs": "4.4.0",
    "kysely": "0.29.8",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@innovera/config": "workspace:*",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "vitest": "5.1.0"
  }
}
