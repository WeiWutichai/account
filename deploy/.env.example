# production secrets — คัดลอกเป็น deploy/.env บนเซิร์ฟเวอร์ (ห้าม commit) · ทุกค่าต้องตั้ง ไม่มีค่าตั้งต้นใน production
DOMAIN=innovera.example                 # โดเมนหลัก → app.<DOMAIN> (ระบบบัญชี) · id.<DOMAIN> (Innovera ID) · admin.<DOMAIN> (Console) · api.<DOMAIN> (/ext/*) — ต้องตรงกับ deploy/caddy/innovera.caddy
EDGE_NETWORK=innovera_edge              # network ของ reverse proxy บนเครื่อง (VPS ปัจจุบัน: juneflow_default) · เครื่องเปล่า: docker network create innovera_edge + --profile standalone
ACME_EMAIL=ops@innovera.example         # อีเมลสำหรับใบรับรอง TLS (Let's Encrypt)
POSTGRES_PASSWORD=                      # superuser (ใช้แค่ตอน init)
MIGRATOR_PASSWORD=
APP_DB_PASSWORD=
CONSOLE_READER_PASSWORD=
REDIS_PASSWORD=
ID_JWT_PRIVATE_JWK=                     # pnpm --filter @innovera/id-api exec tsx -e "import('@innovera/auth').then(async m=>console.log(JSON.stringify((await m.newSigningKey('k1')).privateJwk)))"
ID_DATA_KEY=                            # openssl rand -base64 32
ID_COOKIE_KEY=                          # openssl rand -base64 32
BACKUP_RETENTION_DAYS=14
BACKUP_OFFSITE_TARGET=                  # TODO(Wei): ที่เก็บสำรองนอกเครื่อง (S3-compatible / NAS) — ต้องอยู่ในประเทศไทยตามที่หน้า Login ระบุ
