{
  "name": "innovera-platform",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": "12.18.0"
  },
  "scripts": {
    "dev": "docker compose -f docker/compose.yaml up -d && turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:golden": "pnpm --filter @innovera/golden --filter @innovera/ledger --filter @innovera/tax-th test",
    "check:shared": "node scripts/check-shared-files.mjs",
    "verify": "pnpm check:shared && pnpm lint && pnpm typecheck && pnpm test",
    "db:up": "docker compose -f docker/compose.yaml up -d",
    "db:down": "docker compose -f docker/compose.yaml down",
    "db:migrate": "pnpm --filter @innovera/db migrate",
    "db:migrate:down": "pnpm --filter @innovera/db migrate:down",
    "db:seed": "pnpm --filter @innovera/db seed:dev && pnpm --filter @innovera/id-api seed:dev",
    "dev:session": "pnpm --filter @innovera/id-api session:dev"
  },
  "devDependencies": {
    "@innovera/config": "workspace:*",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "ajv": "8.20.0",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
